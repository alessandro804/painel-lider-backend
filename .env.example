# ===================================================================
# CONFIGURACAO DO BACKEND - LIDER COMMERCE
# ===================================================================
# Copie este arquivo para ".env" e preencha com os valores reais.
# O arquivo .env NUNCA deve ir para o Git (ja esta no .gitignore).
# ===================================================================

# Porta em que o backend vai rodar
PORT=3001

# --- SUPABASE ---
# A URL do projeto Supabase
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# A chave SERVICE ROLE (a poderosa - fica SO no servidor, nunca no painel)
SUPABASE_SERVICE_KEY=sua-chave-service-role-aqui

# --- SEGURANCA ---
# Chave de acesso ao backend. O painel envia ela no header de cada requisicao.
# Gere uma string longa e aleatoria.
API_ACCESS_TOKEN=troque-isto-por-uma-chave-longa-e-aleatoria

# Chave secreta para assinar os tokens de login (JWT).
# Gere outra string longa e aleatoria, DIFERENTE da de cima.
JWT_SECRET=troque-isto-por-outra-chave-longa-e-aleatoria

# Por quanto tempo o login fica valido (ex: 7d = 7 dias, 12h = 12 horas)
JWT_EXPIRA=7d

# Dominios autorizados a chamar este backend (separados por virgula)
# Ex: o endereco do painel no GitHub Pages
CORS_ORIGINS=https://seu-usuario.github.io

# --- MARKETPLACES (preencher quando for integrar) ---
# Shopee
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
# Mercado Livre
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# TikTok Shop
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=

# --- IA (opcional - se quiser que a IA rode pelo backend) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
